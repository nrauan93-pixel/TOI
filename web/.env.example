# Скопируйте этот файл в .env и впишите свои значения.
# Файл .env в GitHub НЕ попадает (он в .gitignore).

# True на своём компьютере, False на сервере
DEBUG=True

# Длинная случайная строка. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Адреса, по которым открывается сайт (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Пусто = SQLite на компьютере. На сервере: строка подключения PostgreSQL из Neon
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Telegram (токен берётся у @BotFather, никому не показывайте)
TELEGRAM_BOT_USERNAME=toi3_bot
TELEGRAM_BOT_TOKEN=
# Chat id для уведомлений о заявках (узнать: написать боту @userinfobot или @getidsbot)
TELEGRAM_ADMIN_CHAT_ID=
# Секретный ключ для бота: такой же ключ Рауан пропишет у себя в боте.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOT_API_KEY=

# Администратор, который создаётся автоматически на сервере (команда ensure_superuser).
# На своём компьютере можно не заполнять — там есть createsuperuser.
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=
